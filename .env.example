# ==============================================================================
# DEBTLENS AI - PRODUCTION ENVIRONMENT CONFIGURATION INVENTORY (.env.example)
# ==============================================================================
# Copy this template to .env or .env.production for deployment staging.
# NEVER commit real production credentials, tokens, or private keys into version control.
# ==============================================================================

# ==============================================================================
# CATEGORY A: MANDATORY FOR BASIC PRODUCTION OPERATION
# ==============================================================================
# Server listening port
PORT=5001

# Runtime environment (Set to 'production' for live deployment)
NODE_ENV=development

# Base API route prefix
API_PREFIX=/api

# Mandatory production allowed origins (comma-separated for multi-domain setups)
# Example: https://debtlens.ai,https://app.debtlens.ai
# NOTE: In production, wildcards (*) and localhost are rejected by startup validation.
CORS_ORIGIN=http://localhost:3000

# Mandatory MongoDB production connection URI (TLS/SSL enabled replica set or MongoDB Atlas)
# Example: mongodb+srv://debtlens_admin:<PASSWORD>@cluster0.abcde.mongodb.net/debtlens_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/debtlens_ai

# Mandatory high-entropy secret key for signing & verifying authorization tokens (min 32 chars)
# NOTE: In production, startup validation halts if default or short secret is used.
JWT_SECRET=replace_with_a_secure_random_production_secret_32chars_minimum
JWT_EXPIRES_IN=7d

# Operational Mode
# In production, set DEMO_MODE=false to enforce live repository analysis only.
# (Defaults to false in production if left unset; defaults to true in development)
DEMO_MODE=false

# ==============================================================================
# CATEGORY B: REQUIRED FOR GITHUB INTEGRATION & CONTINUOUS WEBHOOKS
# ==============================================================================
# Register an OAuth App in GitHub Organization Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=your_github_oauth_app_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret_placeholder

# Webhook payload HMAC-SHA256 verification secret
# Configured in target GitHub repositories under Settings -> Webhooks -> Secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_sha256_secret_placeholder

# Optional override for OAuth callback redirect URL
# Defaults to https://app.debtlens.ai/connections or http://localhost:3000/connections
GITHUB_CALLBACK_URL=https://app.debtlens.ai/connections

# ==============================================================================
# CATEGORY C: OPTIONAL / RESOURCE LIMITS & TUNING
# ==============================================================================
# Rate Limiting (Default: 1000 requests per 15-minute sliding window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# MongoDB Debug logging (Set false in production)
MONGODB_DEBUG=false

# Real Git Ingestion Limits
MAX_REPOSITORY_SIZE_MB=250
MAX_ANALYSIS_FILES=5000
MAX_FILE_SIZE_MB=2
MAX_COMMITS=1000
GIT_CLONE_TIMEOUT_MS=60000
ANALYSIS_TIMEOUT_MS=180000
ANALYSIS_WORKSPACE_DIR=./.analysis-workspaces
ALLOW_LOCAL_FIXTURE_REPOS=false

# ==============================================================================
# CATEGORY D: FRONTEND ENVIRONMENT VARIABLES (Client-side exposed)
# ==============================================================================
# Production backend API root URL
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Application branding title
NEXT_PUBLIC_APP_NAME=DebtLens AI

# Frontend demo mode indicator badge (Set false in production)
NEXT_PUBLIC_DEMO_MODE=false
